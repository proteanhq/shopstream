{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A customer's personal profile information was changed.",
  "properties": {
    "customer_id": {
      "minLength": 1,
      "type": "string"
    },
    "date_of_birth": {
      "anyOf": [
        {
          "maxLength": 10,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "first_name": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "last_name": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "phone": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "customer_id",
    "first_name",
    "last_name"
  ],
  "title": "ProfileUpdated",
  "type": "object",
  "x-protean-aggregate": "identity.customer.customer.Customer",
  "x-protean-element-type": "event",
  "x-protean-fqn": "identity.customer.events.ProfileUpdated",
  "x-protean-type": "Identity.ProfileUpdated.v1",
  "x-protean-version": 1
}
