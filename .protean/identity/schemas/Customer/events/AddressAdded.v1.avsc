        "type": "string"
      }
    },
    {
      "name": "city",
      "type": "string"
    },
    {
      "name": "country",
      "type": "string"
    },
    {
      "name": "customer_id",
      "type": {
        "logicalType": "uuid",
        "type": "string"
      }
    },
    {
      "name": "is_default",
      "type": "boolean"
    },
    {
      "name": "label",
      "type": "string"
    },
    {
      "name": "postal_code",
      "type": "string"
    },
    {
      "default": null,
      "name": "state",
