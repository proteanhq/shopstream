    },
    {
      "name": "last_name",
      "type": "string"
    },
    {
      "default": null,
      "name": "phone",
      "type": [
        "null",
        "string"
      ]
    }
  ],
  "name": "Profile",
  "namespace": "identity.customer.customer",
  "type": "record"
}
