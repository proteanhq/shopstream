{
  "$defs": {
    "Address": {
      "properties": {
        "city": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "country": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "customer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "geo_coordinates": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeoCoordinates"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "is_default": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": false
        },
        "label": {
          "anyOf": [
            {
              "enum": [
                "Home",
                "Other",
                "Work"
              ],
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "Home"
        },
        "postal_code": {
          "maxLength": 20,
          "minLength": 1,
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "street": {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "city",
        "country",
        "id",
        "postal_code",
        "street"
      ],
      "type": "object"
    },
    "EmailAddress": {
      "properties": {
        "address": {
          "maxLength": 254,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "address"
      ],
      "type": "object"
    },
    "GeoCoordinates": {
      "properties": {
        "latitude": {
          "anyOf": [
            {
              "maximum": 90.0,
              "minimum": -90.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "longitude": {
          "anyOf": [
            {
              "maximum": 180.0,
              "minimum": -180.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "Profile": {
      "properties": {
        "date_of_birth": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "first_name": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "last_name": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "phone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "first_name",
        "last_name"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A registered person on the platform, identified by a system ID and an external ID.\n\nThe Customer aggregate groups profile, addresses, account status, and loyalty tier\ninto a single transactional boundary. The \"exactly one default address\" invariant\nrequires these elements to change together consistently.",
  "properties": {
    "addresses": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Address"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "email": {
      "$ref": "#/$defs/EmailAddress"
    },
    "external_id": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "last_login_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/Profile"
        },
        {
          "type": "null"
        }
      ]
    },
    "registered_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "anyOf": [
        {
          "enum": [
            "Active",
            "Closed",
            "Suspended"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "Active"
    },
    "tier": {
      "anyOf": [
        {
          "enum": [
            "Gold",
            "Platinum",
            "Silver",
            "Standard"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "Standard"
    }
  },
  "required": [
    "email",
    "external_id",
    "id"
  ],
  "title": "Customer",
  "type": "object",
  "x-protean-element-type": "aggregate",
  "x-protean-fqn": "identity.customer.customer.Customer",
  "x-protean-identity-field": "id"
}
