{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Change a customer's personal profile information (name, phone, date of birth).",
  "properties": {
    "customer_id": {
      "minLength": 1,
      "type": "string"
    },
    "date_of_birth": {
      "anyOf": [
        {
          "maxLength": 10,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "first_name": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_name": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "phone": {
      "anyOf": [
        {
          "maxLength": 20,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "customer_id"
  ],
  "title": "UpdateProfile",
  "type": "object",
  "x-protean-aggregate": "identity.customer.customer.Customer",
  "x-protean-element-type": "command",
  "x-protean-fqn": "identity.customer.profile.UpdateProfile",
  "x-protean-type": "Identity.UpdateProfile.v1",
  "x-protean-version": 1
}
