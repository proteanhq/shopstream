{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Modify fields of an existing address.",
  "properties": {
    "address_id": {
      "minLength": 1,
      "type": "string"
    },
    "city": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "country": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "customer_id": {
      "minLength": 1,
      "type": "string"
    },
    "label": {
      "anyOf": [
        {
          "maxLength": 20,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "postal_code": {
      "anyOf": [
        {
          "maxLength": 20,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "street": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "address_id",
    "customer_id"
  ],
  "title": "UpdateAddress",
  "type": "object",
  "x-protean-aggregate": "identity.customer.customer.Customer",
  "x-protean-element-type": "command",
  "x-protean-fqn": "identity.customer.addresses.UpdateAddress",
  "x-protean-type": "Identity.UpdateAddress.v1",
  "x-protean-version": 1
}
