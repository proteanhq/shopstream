{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "customer_id": {
      "minLength": 1,
      "type": "string"
    },
    "email": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "external_id": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "first_name": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "last_name": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "phone": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "registered_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "tier": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "customer_id",
    "email",
    "external_id",
    "first_name",
    "last_name",
    "status",
    "tier"
  ],
  "title": "CustomerCard",
  "type": "object",
  "x-protean-element-type": "projection",
  "x-protean-fqn": "identity.projections.customer_card.CustomerCard",
  "x-protean-identity-field": "customer_id"
}
