{
  "$defs": {
    "Dimensions": {
      "properties": {
        "height": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "length": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "cm"
        },
        "width": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "Image": {
      "properties": {
        "alt_text": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "display_order": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 0
        },
        "id": {
          "type": "string"
        },
        "is_primary": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": false
        },
        "product": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "url"
      ],
      "type": "object"
    },
    "Price": {
      "properties": {
        "base_price": {
          "minimum": 0.01,
          "type": "number"
        },
        "currency": {
          "anyOf": [
            {
              "maxLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "USD"
        },
        "tier_prices": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "base_price"
      ],
      "type": "object"
    },
    "SEO": {
      "properties": {
        "meta_description": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "meta_title": {
          "anyOf": [
            {
              "maxLength": 70,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "slug": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "SKU": {
      "properties": {
        "code": {
          "maxLength": 50,
          "minLength": 3,
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "type": "object"
    },
    "Variant": {
      "properties": {
        "attributes": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "dimensions": {
          "anyOf": [
            {
              "$ref": "#/$defs/Dimensions"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "is_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": true
        },
        "price": {
          "$ref": "#/$defs/Price"
        },
        "product": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "variant_sku": {
          "$ref": "#/$defs/SKU"
        },
        "weight": {
          "anyOf": [
            {
              "$ref": "#/$defs/Weight"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "price",
        "variant_sku"
      ],
      "type": "object"
    },
    "Weight": {
      "properties": {
        "unit": {
          "anyOf": [
            {
              "maxLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "kg"
        },
        "value": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A sellable item in the catalogue, identified by a unique SKU.\n\nThe Product aggregate groups variants, images, pricing, and SEO metadata\ninto a single transactional boundary. Its lifecycle follows a forward-only\nstate machine: Draft -> Active -> Discontinued -> Archived. A product must\nhave at least one variant before activation.",
  "properties": {
    "attributes": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "brand": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "category_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "type": "string"
    },
    "images": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Image"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "seller_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "seo": {
      "anyOf": [
        {
          "$ref": "#/$defs/SEO"
        },
        {
          "type": "null"
        }
      ]
    },
    "sku": {
      "$ref": "#/$defs/SKU"
    },
    "status": {
      "anyOf": [
        {
          "enum": [
            "Active",
            "Archived",
            "Discontinued",
            "Draft"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "Draft"
    },
    "title": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "variants": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Variant"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "visibility": {
      "anyOf": [
        {
          "enum": [
            "Public",
            "Tier_Restricted",
            "Unlisted"
          ],
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "Public"
    }
  },
  "required": [
    "id",
    "sku",
    "title"
  ],
  "title": "Product",
  "type": "object",
  "x-protean-element-type": "aggregate",
  "x-protean-fqn": "catalogue.product.product.Product",
  "x-protean-identity-field": "id"
}
