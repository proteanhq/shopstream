{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A visual representation of a Product, with URL and display ordering.\n\nA product may have up to 10 images, with exactly one marked as primary.\nThe first image added is automatically set as primary.",
  "properties": {
    "alt_text": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "display_order": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": 0
    },
    "id": {
      "type": "string"
    },
    "is_primary": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": false
    },
    "product": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "url": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "id",
    "url"
  ],
  "title": "Image",
  "type": "object",
  "x-protean-aggregate": "catalogue.product.product.Product",
  "x-protean-element-type": "entity",
  "x-protean-fqn": "catalogue.product.product.Image",
  "x-protean-identity-field": "id"
}
