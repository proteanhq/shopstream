{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A new product was added to the catalogue in Draft status.",
  "properties": {
    "category_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "product_id": {
      "minLength": 1,
      "type": "string"
    },
    "seller_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "sku": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "created_at",
    "product_id",
    "sku",
    "status",
    "title"
  ],
  "title": "ProductCreated",
  "type": "object",
  "x-protean-aggregate": "catalogue.product.product.Product",
  "x-protean-element-type": "event",
  "x-protean-fqn": "catalogue.product.events.ProductCreated",
  "x-protean-published": true,
  "x-protean-type": "Catalogue.ProductCreated.v1",
  "x-protean-version": 1
}
