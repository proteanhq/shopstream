{
  "doc": "A new purchasable variant was added to a product.",
  "fields": [
    {
      "name": "created_at",
      "type": {
        "logicalType": "timestamp-millis",
        "type": "long"
      }
    },
    {
      "name": "price_amount",
      "type": {
        "logicalType": "decimal",
        "precision": 19,
        "scale": 4,
        "type": "bytes"
      }
    },
    {
      "name": "price_currency",
      "type": "string"
    },
    {
      "name": "product_id",
      "type": {
        "logicalType": "uuid",
        "type": "string"
      }
    },
    {
      "name": "variant_id",
      "type": {
        "logicalType": "uuid",
        "type": "string"
      }
    },
    {
      "name": "variant_sku",
      "type": "string"
    }
  ],
  "name": "VariantAdded",
  "namespace": "catalogue.product.events",
  "type": "record"
}
