{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A variant's base price was updated.",
  "properties": {
    "currency": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "new_price": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
      "type": "string",
      "x-precision": 19,
      "x-scale": 4
    },
    "previous_price": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
      "type": "string",
      "x-precision": 19,
      "x-scale": 4
    },
    "product_id": {
      "minLength": 1,
      "type": "string"
    },
    "variant_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "currency",
    "new_price",
    "previous_price",
    "product_id",
    "variant_id"
  ],
  "title": "VariantPriceChanged",
  "type": "object",
  "x-protean-aggregate": "catalogue.product.product.Product",
  "x-protean-element-type": "event",
  "x-protean-fqn": "catalogue.product.events.VariantPriceChanged",
  "x-protean-type": "Catalogue.VariantPriceChanged.v2",
  "x-protean-version": 2
}
