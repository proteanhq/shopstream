{
  "doc": "The monetary cost of a variant, with optional loyalty-tier discounts.\n\nBase price is the standard retail price. Tier prices map a tier name to a\n`TierPrice`, allowing different pricing for Silver, Gold, and Platinum\ncustomers. Tier prices must always be lower than the base price.",
  "fields": [
    {
      "name": "base_price",
      "type": {
        "logicalType": "decimal",
        "precision": 19,
        "scale": 4,
        "type": "bytes"
      }
    },
    {
      "default": null,
      "name": "currency",
      "type": [
        "null",
        "string"
      ]
    },
    {
      "default": null,
      "name": "tier_prices",
      "type": [
        "null",
        {
          "type": "map",
          "values": "string"
        }
      ]
    }
  ],
  "name": "Price",
  "namespace": "catalogue.product.product",
  "type": "record"
}
