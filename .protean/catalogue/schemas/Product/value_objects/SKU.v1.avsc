{
  "doc": "Value object for stock keeping unit codes.\n\nFormat: alphanumeric + hyphens, 3-50 chars.\nE.g., \"ELEC-PHN-001\", \"SHOE-RUN-BLK-42\"\n\nExamples:\n    >>> SKU(code=\"ELEC-PHN-001\").code\n    'ELEC-PHN-001'\n    >>> try:\n    ...     SKU(code=\"bad--code\")  # consecutive hyphens\n    ... except ValidationError:\n    ...     print(\"rejected\")\n    rejected\n    >>> try:\n    ...     SKU(code=\"-leads-with-hyphen\")\n    ... except ValidationError:\n    ...     print(\"rejected\")\n    rejected\n    >>> try:\n    ...     SKU(code=\"ab\")  # shorter than 3 chars\n    ... except ValidationError:\n    ...     print(\"rejected\")\n    rejected",
  "fields": [
    {
      "name": "code",
      "type": "string"
    }
  ],
  "name": "SKU",
  "namespace": "catalogue.shared.sku",
  "type": "record"
}
