{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The monetary cost of a variant, with optional loyalty-tier discounts.\n\nBase price is the standard retail price. Tier prices map a tier name to a\n`TierPrice`, allowing different pricing for Silver, Gold, and Platinum\ncustomers. Tier prices must always be lower than the base price.",
  "properties": {
    "base_price": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
      "type": "string",
      "x-precision": 19,
      "x-scale": 4
    },
    "currency": {
      "anyOf": [
        {
          "maxLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "USD"
    },
    "tier_prices": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "base_price"
  ],
  "title": "Price",
  "type": "object",
  "x-protean-aggregate": "catalogue.product.product.Product",
  "x-protean-element-type": "value_object",
  "x-protean-fqn": "catalogue.product.product.Price"
}
