{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Physical weight of a product or variant, used for shipping calculations.\n\nSupports kilograms (kg), pounds (lb), grams (g), and ounces (oz).",
  "properties": {
    "unit": {
      "anyOf": [
        {
          "maxLength": 2,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "kg"
    },
    "value": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "title": "Weight",
  "type": "object",
  "x-protean-aggregate": "catalogue.product.product.Product",
  "x-protean-element-type": "value_object",
  "x-protean-fqn": "catalogue.product.product.Weight"
}
