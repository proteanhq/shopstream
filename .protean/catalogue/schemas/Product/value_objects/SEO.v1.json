{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Search engine optimization metadata for a product page.\n\nContains meta title (max 70 chars), meta description (max 160 chars), and a\nURL-safe slug. The slug must be lowercase alphanumeric with hyphens only.",
  "properties": {
    "meta_description": {
      "anyOf": [
        {
          "maxLength": 160,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "meta_title": {
      "anyOf": [
        {
          "maxLength": 70,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "slug": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "title": "SEO",
  "type": "object",
  "x-protean-aggregate": "catalogue.product.product.Product",
  "x-protean-element-type": "value_object",
  "x-protean-fqn": "catalogue.product.product.SEO"
}
