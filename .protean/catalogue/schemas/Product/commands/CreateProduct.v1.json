{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Add a new product to the catalogue in Draft status.",
  "properties": {
    "attributes": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "brand": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "category_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "description": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "meta_description": {
      "anyOf": [
        {
          "maxLength": 160,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "meta_title": {
      "anyOf": [
        {
          "maxLength": 70,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "seller_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "sku": {
      "maxLength": 50,
      "minLength": 1,
      "type": "string"
    },
    "slug": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "visibility": {
      "anyOf": [
        {
          "maxLength": 20,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "sku",
    "title"
  ],
  "title": "CreateProduct",
  "type": "object",
  "x-protean-aggregate": "catalogue.product.product.Product",
  "x-protean-element-type": "command",
  "x-protean-fqn": "catalogue.product.creation.CreateProduct",
  "x-protean-type": "Catalogue.CreateProduct.v1",
  "x-protean-version": 1
}
