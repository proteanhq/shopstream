{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Change the base price of an existing variant.",
  "properties": {
    "base_price": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
      "type": "string",
      "x-precision": 19,
      "x-scale": 4
    },
    "currency": {
      "anyOf": [
        {
          "maxLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "USD"
    },
    "product_id": {
      "minLength": 1,
      "type": "string"
    },
    "variant_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "base_price",
    "product_id",
    "variant_id"
  ],
  "title": "UpdateVariantPrice",
  "type": "object",
  "x-protean-aggregate": "catalogue.product.product.Product",
  "x-protean-element-type": "command",
  "x-protean-fqn": "catalogue.product.variants.UpdateVariantPrice",
  "x-protean-type": "Catalogue.UpdateVariantPrice.v1",
  "x-protean-version": 1
}
