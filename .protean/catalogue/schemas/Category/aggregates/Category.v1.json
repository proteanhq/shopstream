{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A hierarchical grouping for organizing products in the catalogue.\n\nCategories form a tree up to 5 levels deep (0-4). Each category can have a\nparent, custom attributes, and a display order for controlling presentation.",
  "properties": {
    "attributes": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "display_order": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": 0
    },
    "id": {
      "type": "string"
    },
    "is_active": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": true
    },
    "level": {
      "anyOf": [
        {
          "maximum": 4,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": 0
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    },
    "parent_category_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "name"
  ],
  "title": "Category",
  "type": "object",
  "x-protean-element-type": "aggregate",
  "x-protean-fqn": "catalogue.category.category.Category",
  "x-protean-identity-field": "id"
}
