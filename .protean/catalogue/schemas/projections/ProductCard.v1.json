{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "brand": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "category_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "currency": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "max_price": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "min_price": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "primary_image_url": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "product_id": {
      "minLength": 1,
      "type": "string"
    },
    "sku": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "variant_count": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": 0
    }
  },
  "required": [
    "product_id",
    "sku",
    "status",
    "title"
  ],
  "title": "ProductCard",
  "type": "object",
  "x-protean-element-type": "projection",
  "x-protean-fqn": "catalogue.projections.product_card.ProductCard",
  "x-protean-identity-field": "product_id"
}
