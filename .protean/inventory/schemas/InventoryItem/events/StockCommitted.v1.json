{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Reserved stock was committed (shipped), reducing on-hand quantity.",
  "properties": {
    "committed_at": {
      "format": "date-time",
      "type": "string"
    },
    "inventory_item_id": {
      "minLength": 1,
      "type": "string"
    },
    "new_on_hand": {
      "type": "integer"
    },
    "new_reserved": {
      "type": "integer"
    },
    "order_id": {
      "minLength": 1,
      "type": "string"
    },
    "previous_on_hand": {
      "type": "integer"
    },
    "previous_reserved": {
      "type": "integer"
    },
    "quantity": {
      "type": "integer"
    },
    "reservation_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "committed_at",
    "inventory_item_id",
    "new_on_hand",
    "new_reserved",
    "order_id",
    "previous_on_hand",
    "previous_reserved",
    "quantity",
    "reservation_id"
  ],
  "title": "StockCommitted",
  "type": "object",
  "x-protean-aggregate": "inventory.stock.stock.InventoryItem",
  "x-protean-element-type": "event",
  "x-protean-fqn": "inventory.stock.events.StockCommitted",
  "x-protean-type": "Inventory.StockCommitted.v1",
  "x-protean-version": 1
}
