{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Stock was reserved for an order, decreasing available quantity.",
  "properties": {
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "inventory_item_id": {
      "minLength": 1,
      "type": "string"
    },
    "new_available": {
      "type": "integer"
    },
    "order_id": {
      "minLength": 1,
      "type": "string"
    },
    "previous_available": {
      "type": "integer"
    },
    "quantity": {
      "type": "integer"
    },
    "reservation_id": {
