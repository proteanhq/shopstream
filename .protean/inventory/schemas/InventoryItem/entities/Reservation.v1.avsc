{
  "doc": "A hold on inventory for a specific order.\n\nReservations transition through: Active \u2192 Confirmed \u2192 (committed via\nCommitStock), or Active \u2192 Released (cancelled/expired).",
  "fields": [
    {
      "name": "expires_at",
      "type": {
        "logicalType": "timestamp-millis",
        "type": "long"
      }
    },
    {
      "name": "id",
      "type": "string"
    },
    {
      "default": null,
      "name": "inventory_item",
      "type": [
        "null",
        "string"
      ]
    },
    {
      "name": "order_id",
      "type": {
        "logicalType": "uuid",
        "type": "string"
      }
    },
    {
      "name": "quantity",
      "type": "long"
    },
    {
      "name": "reserved_at",
      "type": {
        "logicalType": "timestamp-millis",
        "type": "long"
      }
    },
    {
      "default": null,
      "name": "status",
      "type": [
        "null",
        "string"
      ]
    }
  ],
  "name": "Reservation",
  "namespace": "inventory.stock.stock",
  "type": "record"
}
