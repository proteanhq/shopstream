{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "capacity": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": 0
    },
    "city": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "country": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "is_active": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": true
    },
    "name": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "warehouse_id": {
      "minLength": 1,
      "type": "string"
    },
    "zone_count": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": 0
    }
  },
  "required": [
    "name",
    "warehouse_id"
  ],
  "title": "WarehouseDirectory",
  "type": "object",
  "x-protean-element-type": "projection",
  "x-protean-fqn": "inventory.projections.warehouse_directory.WarehouseDirectory",
  "x-protean-identity-field": "warehouse_id"
}
