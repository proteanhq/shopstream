{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "adjustment_reasons": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "inventory_item_id": {
      "minLength": 1,
      "type": "string"
    },
    "last_adjustment_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "product_id": {
      "minLength": 1,
      "type": "string"
    },
    "sku": {
      "anyOf": [
        {
          "maxLength": 50,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "total_adjustments": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": 0
    },
    "total_damaged": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": 0
    },
    "total_shrinkage_value": {
      "anyOf": [
        {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
          "type": "string",
          "x-precision": 19,
          "x-scale": 4
        },
        {
          "type": "null"
        }
      ],
      "default": "0"
    },
    "total_written_off": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": 0
    },
    "warehouse_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "inventory_item_id",
    "product_id"
  ],
  "title": "ShrinkageReport",
  "type": "object",
  "x-protean-element-type": "projection",
  "x-protean-fqn": "inventory.projections.shrinkage_report.ShrinkageReport",
  "x-protean-identity-field": "inventory_item_id"
}
