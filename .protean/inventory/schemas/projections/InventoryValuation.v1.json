{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "inventory_item_id": {
      "minLength": 1,
      "type": "string"
    },
    "on_hand": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": 0
    },
    "product_id": {
      "minLength": 1,
      "type": "string"
    },
    "sku": {
      "anyOf": [
        {
          "maxLength": 50,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "total_value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": 0.0
    },
    "unit_cost": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": 0.0
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "variant_id": {
      "minLength": 1,
      "type": "string"
    },
    "warehouse_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "inventory_item_id",
    "product_id",
    "variant_id"
  ],
  "title": "InventoryValuation",
  "type": "object",
  "x-protean-element-type": "projection",
  "x-protean-fqn": "inventory.projections.inventory_valuation.InventoryValuation",
  "x-protean-identity-field": "inventory_item_id"
}
