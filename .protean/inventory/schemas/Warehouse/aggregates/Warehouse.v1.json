        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "name"
  ],
  "title": "Warehouse",
  "type": "object",
  "x-protean-element-type": "aggregate",
  "x-protean-fqn": "inventory.warehouse.warehouse.Warehouse",
