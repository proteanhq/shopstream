{
  "$defs": {
    "WarehouseAddress": {
      "properties": {
        "city": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "country": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "postal_code": {
          "maxLength": 20,
          "minLength": 1,
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "street": {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "city",
        "country",
        "postal_code",
        "street"
      ],
      "type": "object"
    },
    "Zone": {
      "properties": {
        "id": {
          "type": "string"
        },
        "warehouse": {
