{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "amount": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt_number": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "customer_id": {
      "minLength": 1,
      "type": "string"
    },
    "failed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "order_id": {
      "minLength": 1,
      "type": "string"
    },
    "payment_id": {
      "minLength": 1,
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "customer_id",
    "order_id",
    "payment_id",
    "status"
  ],
  "title": "FailedPayment",
  "type": "object",
  "x-protean-element-type": "projection",
  "x-protean-fqn": "payments.projections.failed_payments.FailedPayment",
  "x-protean-identity-field": "payment_id"
}
