{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "currency": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "USD"
    },
    "date": {
      "maxLength": 10,
      "minLength": 1,
      "type": "string"
    },
    "net_revenue": {
      "anyOf": [
        {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
          "type": "string",
          "x-precision": 19,
          "x-scale": 4
        },
        {
          "type": "null"
        }
      ],
      "default": "0"
    },
    "refund_count": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": 0
    },
    "total_refunded": {
      "anyOf": [
        {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
          "type": "string",
          "x-precision": 19,
          "x-scale": 4
        },
        {
          "type": "null"
        }
      ],
      "default": "0"
    },
    "total_revenue": {
      "anyOf": [
        {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
          "type": "string",
          "x-precision": 19,
          "x-scale": 4
        },
        {
          "type": "null"
        }
      ],
      "default": "0"
    },
    "transaction_count": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": 0
    }
  },
  "required": [
    "date"
  ],
  "title": "DailyRevenue",
  "type": "object",
  "x-protean-element-type": "projection",
  "x-protean-fqn": "payments.projections.daily_revenue.DailyRevenue",
  "x-protean-identity-field": "date"
}
