{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Payment processing failed at the gateway.",
  "properties": {
    "attempt_number": {
      "type": "integer"
    },
    "can_retry": {
      "type": "boolean"
    },
    "customer_id": {
      "minLength": 1,
      "type": "string"
    },
    "failed_at": {
      "format": "date-time",
      "type": "string"
    },
    "order_id": {
      "minLength": 1,
      "type": "string"
    },
    "payment_id": {
      "minLength": 1,
      "type": "string"
    },
    "reason": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "attempt_number",
    "can_retry",
    "customer_id",
    "failed_at",
    "order_id",
    "payment_id",
    "reason"
  ],
  "title": "PaymentFailed",
  "type": "object",
  "x-protean-aggregate": "payments.payment.payment.Payment",
  "x-protean-element-type": "event",
  "x-protean-fqn": "payments.payment.events.PaymentFailed",
  "x-protean-published": true,
  "x-protean-type": "Payments.PaymentFailed.v1",
  "x-protean-version": 1
}
