{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A refund against this payment.",
  "properties": {
    "amount": {
      "type": "number"
    },
    "gateway_refund_id": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "type": "string"
    },
    "payment": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "processed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    },
    "requested_at": {
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "enum": [
            "Completed",
            "Failed",
            "Processing",
            "Requested"
          ],
          "maxLength": 50,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "Requested"
    }
  },
  "required": [
    "amount",
    "id",
    "reason",
    "requested_at"
  ],
  "title": "Refund",
  "type": "object",
  "x-protean-aggregate": "payments.payment.payment.Payment",
  "x-protean-element-type": "entity",
  "x-protean-fqn": "payments.payment.payment.Refund",
  "x-protean-identity-field": "id"
}
