{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Monetary amount with currency.",
  "properties": {
    "currency": {
      "anyOf": [
        {
          "maxLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "USD"
    },
    "value": {
      "anyOf": [
        {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
          "type": "string",
          "x-precision": 19,
          "x-scale": 4
        },
        {
          "type": "null"
        }
      ],
      "default": "0"
    }
  },
  "title": "Money",
  "type": "object",
  "x-protean-aggregate": "payments.payment.payment.Payment",
  "x-protean-element-type": "value_object",
  "x-protean-fqn": "payments.payment.payment.Money"
}
