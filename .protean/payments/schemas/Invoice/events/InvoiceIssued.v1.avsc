      "type": {
        "logicalType": "timestamp-millis",
        "type": "long"
      }
    },
    {
      "name": "order_id",
      "type": {
        "logicalType": "uuid",
        "type": "string"
      }
    }
  ],
  "name": "InvoiceIssued",
