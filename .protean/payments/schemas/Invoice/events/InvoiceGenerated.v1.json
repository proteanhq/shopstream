{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A new invoice was generated for an order.",
  "properties": {
    "customer_id": {
      "minLength": 1,
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "type": "string"
    },
    "invoice_id": {
      "minLength": 1,
      "type": "string"
    },
    "invoice_number": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "order_id": {
      "minLength": 1,
      "type": "string"
    },
    "total": {
      "type": "number"
    }
  },
  "required": [
    "customer_id",
    "generated_at",
    "invoice_id",
    "invoice_number",
    "order_id",
    "total"
  ],
  "title": "InvoiceGenerated",
  "type": "object",
  "x-protean-aggregate": "payments.invoice.invoice.Invoice",
  "x-protean-element-type": "event",
  "x-protean-fqn": "payments.invoice.events.InvoiceGenerated",
  "x-protean-type": "Payments.InvoiceGenerated.v1",
  "x-protean-version": 1
}
