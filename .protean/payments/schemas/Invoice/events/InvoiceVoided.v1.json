  "description": "An invoice was voided/cancelled.",
  "properties": {
    "invoice_id": {
      "minLength": 1,
      "type": "string"
    },
    "order_id": {
      "minLength": 1,
      "type": "string"
    },
    "reason": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "voided_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "invoice_id",
    "order_id",
    "reason",
    "voided_at"
  ],
  "title": "InvoiceVoided",
  "type": "object",
  "x-protean-aggregate": "payments.invoice.invoice.Invoice",
