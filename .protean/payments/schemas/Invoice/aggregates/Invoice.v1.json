{
  "$defs": {
    "InvoiceLineItem": {
      "properties": {
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "invoice": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "quantity": {
          "type": "number"
        },
        "total": {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
          "type": "string",
          "x-precision": 19,
          "x-scale": 4
        },
        "unit_price": {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
          "type": "string",
          "x-precision": 19,
          "x-scale": 4
        }
      },
      "required": [
        "description",
        "id",
        "quantity",
        "total",
        "unit_price"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "customer_id": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "invoice_number": {
      "maxLength": 50,
      "minLength": 1,
      "type": "string"
    },
    "issued_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "line_items": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/InvoiceLineItem"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "order_id": {
      "minLength": 1,
      "type": "string"
    },
    "paid_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "anyOf": [
        {
          "enum": [
            "Draft",
            "Issued",
            "Paid",
            "Voided"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "Draft"
    },
    "subtotal": {
      "anyOf": [
        {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
          "type": "string",
          "x-precision": 19,
          "x-scale": 4
        },
        {
          "type": "null"
        }
      ],
      "default": "0"
    },
    "tax": {
      "anyOf": [
        {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
          "type": "string",
          "x-precision": 19,
          "x-scale": 4
        },
        {
          "type": "null"
        }
      ],
      "default": "0"
    },
    "total": {
      "anyOf": [
        {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
          "type": "string",
          "x-precision": 19,
          "x-scale": 4
        },
        {
          "type": "null"
        }
      ],
      "default": "0"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "customer_id",
    "id",
    "invoice_number",
    "order_id"
  ],
  "title": "Invoice",
  "type": "object",
  "x-protean-element-type": "aggregate",
  "x-protean-fqn": "payments.invoice.invoice.Invoice",
  "x-protean-identity-field": "id"
}
