{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A photo attached to a review.",
  "properties": {
    "alt_text": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "display_order": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": 0
    },
    "id": {
      "type": "string"
    },
    "review": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "url": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "id",
    "url"
  ],
  "title": "ReviewImage",
  "type": "object",
  "x-protean-aggregate": "reviews.review.review.Review",
  "x-protean-element-type": "entity",
  "x-protean-fqn": "reviews.review.review.ReviewImage",
  "x-protean-identity-field": "id"
}
