{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A moderator rejected the review.",
  "properties": {
    "customer_id": {
      "minLength": 1,
      "type": "string"
    },
    "moderator_id": {
      "minLength": 1,
      "type": "string"
    },
    "product_id": {
      "minLength": 1,
      "type": "string"
    },
    "reason": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "rejected_at": {
      "format": "date-time",
      "type": "string"
    },
    "review_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "customer_id",
    "moderator_id",
    "product_id",
    "reason",
    "rejected_at",
    "review_id"
  ],
  "title": "ReviewRejected",
  "type": "object",
  "x-protean-aggregate": "reviews.review.review.Review",
  "x-protean-element-type": "event",
  "x-protean-fqn": "reviews.review.events.ReviewRejected",
  "x-protean-published": true,
  "x-protean-type": "Reviews.ReviewRejected.v1",
  "x-protean-version": 1
}
