{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "body": {
      "minLength": 1,
      "type": "string"
    },
    "customer_id": {
      "minLength": 1,
      "type": "string"
    },
    "last_reported_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "product_id": {
      "minLength": 1,
      "type": "string"
    },
    "rating": {
      "type": "integer"
    },
    "report_count": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": 0
    },
    "review_id": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "submitted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "verified_purchase": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "body",
    "customer_id",
    "product_id",
    "rating",
    "review_id",
    "status",
    "title"
  ],
  "title": "ModerationQueue",
  "type": "object",
  "x-protean-element-type": "projection",
  "x-protean-fqn": "reviews.projections.moderation_queue.ModerationQueue",
  "x-protean-identity-field": "review_id"
}
