{
  "$defs": {
    "CartItem": {
      "properties": {
        "added_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "product_id": {
          "minLength": 1,
          "type": "string"
        },
        "quantity": {
          "minimum": 1,
          "type": "integer"
        },
        "shopping_cart": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "variant_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "product_id",
        "quantity",
        "variant_id"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "applied_coupons": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "customer_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "type": "string"
    },
    "items": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/CartItem"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "session_id": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "anyOf": [
        {
          "enum": [
            "Abandoned",
            "Active",
            "Converted"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "Active"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id"
  ],
  "title": "ShoppingCart",
  "type": "object",
  "x-protean-element-type": "aggregate",
  "x-protean-fqn": "ordering.cart.cart.ShoppingCart",
  "x-protean-identity-field": "id"
}
