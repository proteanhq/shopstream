{
  "doc": "An item in a shopping cart, tracking only product reference and quantity.\n\nCart items do not store prices \u2014 prices are resolved from the Catalogue\ncontext at checkout time and locked on the Order.",
  "fields": [
    {
      "default": null,
      "name": "added_at",
      "type": [
        "null",
        {
          "logicalType": "timestamp-millis",
          "type": "long"
        }
      ]
    },
    {
      "name": "id",
      "type": "string"
    },
    {
      "name": "product_id",
      "type": {
        "logicalType": "uuid",
        "type": "string"
      }
    },
    {
      "name": "quantity",
      "type": "long"
    },
    {
      "default": null,
      "name": "shopping_cart",
      "type": [
        "null",
        "string"
      ]
    },
    {
      "name": "variant_id",
      "type": {
        "logicalType": "uuid",
        "type": "string"
      }
    }
  ],
  "name": "CartItem",
  "namespace": "ordering.cart.cart",
  "type": "record"
}
