{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A line item in an order, representing a specific product variant and quantity.\n\nEach item tracks its own status through the fulfillment lifecycle\n(Pending -> Shipped -> Delivered -> optionally Returned), enabling partial\nshipments where some items ship before others.",
  "properties": {
    "discount": {
      "anyOf": [
        {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
          "type": "string",
          "x-precision": 19,
          "x-scale": 4
        },
        {
          "type": "null"
        }
      ],
      "default": "0.0000"
    },
    "id": {
      "type": "string"
    },
    "item_status": {
      "anyOf": [
        {
          "enum": [
            "Delivered",
            "Pending",
            "Reserved",
            "Returned",
            "Shipped"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "Pending"
    },
    "order": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "product_id": {
      "minLength": 1,
      "type": "string"
    },
    "quantity": {
      "minimum": 1,
      "type": "integer"
    },
    "sku": {
      "maxLength": 50,
      "minLength": 1,
      "type": "string"
    },
    "tax_amount": {
      "anyOf": [
        {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
          "type": "string",
          "x-precision": 19,
          "x-scale": 4
        },
        {
          "type": "null"
        }
      ],
      "default": "0.0000"
    },
    "title": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "unit_price": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
      "type": "string",
      "x-precision": 19,
      "x-scale": 4
    },
    "variant_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "id",
    "product_id",
    "quantity",
    "sku",
    "title",
    "unit_price",
    "variant_id"
  ],
  "title": "OrderItem",
  "type": "object",
  "x-protean-aggregate": "ordering.order.order.Order",
  "x-protean-element-type": "entity",
  "x-protean-fqn": "ordering.order.order.OrderItem",
  "x-protean-identity-field": "id"
}
