{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Financial summary of an order: subtotal, shipping, tax, discounts, and grand total.\n\nPrices are locked at checkout and never change, even if the catalogue prices\nchange later. The currency is captured alongside the amounts.",
  "properties": {
    "currency": {
      "anyOf": [
        {
          "maxLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "USD"
    },
    "discount_total": {
      "anyOf": [
        {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
          "type": "string",
          "x-precision": 19,
          "x-scale": 4
        },
        {
          "type": "null"
        }
      ],
      "default": "0.0000"
    },
    "grand_total": {
      "anyOf": [
        {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
          "type": "string",
          "x-precision": 19,
          "x-scale": 4
        },
        {
          "type": "null"
        }
      ],
      "default": "0.0000"
    },
    "shipping_cost": {
      "anyOf": [
        {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
          "type": "string",
          "x-precision": 19,
          "x-scale": 4
        },
        {
          "type": "null"
        }
      ],
      "default": "0.0000"
    },
    "subtotal": {
      "anyOf": [
        {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
          "type": "string",
          "x-precision": 19,
          "x-scale": 4
        },
        {
          "type": "null"
        }
      ],
      "default": "0.0000"
    },
    "tax_total": {
      "anyOf": [
        {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
          "type": "string",
          "x-precision": 19,
          "x-scale": 4
        },
        {
          "type": "null"
        }
      ],
      "default": "0.0000"
    }
  },
  "title": "OrderPricing",
  "type": "object",
  "x-protean-aggregate": "ordering.order.order.Order",
  "x-protean-element-type": "value_object",
  "x-protean-fqn": "ordering.order.order.OrderPricing"
}
