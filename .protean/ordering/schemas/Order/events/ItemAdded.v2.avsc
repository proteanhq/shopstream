      "name": "added_at",
      "type": {
        "logicalType": "timestamp-millis",
        "type": "long"
      }
    },
    {
      "name": "item_id",
      "type": {
        "logicalType": "uuid",
        "type": "string"
      }
    },
    {
      "name": "new_grand_total",
      "type": {
        "logicalType": "decimal",
        "precision": 19,
        "scale": 4,
        "type": "bytes"
      }
    },
    {
      "name": "new_subtotal",
      "type": {
        "logicalType": "decimal",
        "precision": 19,
        "scale": 4,
        "type": "bytes"
      }
    },
    {
      "name": "order_id",
      "type": {
        "logicalType": "uuid",
        "type": "string"
      }
    },
    {
      "name": "product_id",
      "type": {
        "logicalType": "uuid",
        "type": "string"
      }
    },
    {
      "name": "quantity",
      "type": "string"
    },
    {
      "name": "sku",
      "type": "string"
    },
    {
      "name": "title",
      "type": "string"
    },
    {
      "name": "unit_price",
      "type": "string"
    },
    {
      "name": "variant_id",
      "type": {
        "logicalType": "uuid",
        "type": "string"
      }
    }
  ],
  "name": "ItemAdded",
  "namespace": "ordering.order.events",
  "type": "record"
