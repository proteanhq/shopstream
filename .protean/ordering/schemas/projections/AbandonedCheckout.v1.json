{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "currency": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "USD"
    },
    "customer_id": {
      "minLength": 1,
      "type": "string"
    },
    "grand_total": {
      "anyOf": [
        {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
          "type": "string",
          "x-precision": 19,
          "x-scale": 4
        },
        {
          "type": "null"
        }
      ],
      "default": "0"
    },
    "item_count": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": 0
    },
    "order_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "customer_id",
    "order_id"
  ],
  "title": "AbandonedCheckout",
  "type": "object",
  "x-protean-element-type": "projection",
  "x-protean-fqn": "ordering.projections.abandoned_checkouts.AbandonedCheckout",
  "x-protean-identity-field": "order_id"
}
