{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "carrier": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "current_location": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "current_status": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "delivered_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "events": {
      "anyOf": [
        {
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "fulfillment_id": {
      "minLength": 1,
      "type": "string"
    },
    "order_id": {
      "minLength": 1,
      "type": "string"
    },
    "shipped_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "tracking_number": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "current_status",
    "fulfillment_id",
    "order_id"
  ],
  "title": "ShipmentTrackingView",
  "type": "object",
  "x-protean-element-type": "projection",
  "x-protean-fqn": "fulfillment.projections.shipment_tracking.ShipmentTrackingView",
  "x-protean-identity-field": "fulfillment_id"
}
