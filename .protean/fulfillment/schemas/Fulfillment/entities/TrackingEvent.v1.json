{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A carrier tracking event.",
  "properties": {
    "description": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "fulfillment": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "type": "string"
    },
    "location": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "occurred_at": {
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "id",
    "occurred_at",
    "status"
  ],
  "title": "TrackingEvent",
  "type": "object",
  "x-protean-aggregate": "fulfillment.fulfillment.fulfillment.Fulfillment",
  "x-protean-element-type": "entity",
  "x-protean-fqn": "fulfillment.fulfillment.fulfillment.TrackingEvent",
  "x-protean-identity-field": "id"
}
