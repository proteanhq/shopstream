{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Record that the shipment has been handed off to the carrier.",
  "properties": {
    "estimated_delivery": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "fulfillment_id": {
      "minLength": 1,
      "type": "string"
    },
    "tracking_number": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "fulfillment_id",
    "tracking_number"
  ],
  "title": "RecordHandoff",
  "type": "object",
  "x-protean-aggregate": "fulfillment.fulfillment.fulfillment.Fulfillment",
  "x-protean-element-type": "command",
  "x-protean-fqn": "fulfillment.fulfillment.shipping.RecordHandoff",
  "x-protean-type": "Fulfillment.RecordHandoff.v1",
  "x-protean-version": 1
}
