{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The carrier reported a delivery exception.",
  "properties": {
    "fulfillment_id": {
      "minLength": 1,
      "type": "string"
    },
    "location": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "occurred_at": {
      "format": "date-time",
      "type": "string"
    },
    "order_id": {
      "minLength": 1,
      "type": "string"
    },
    "reason": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "fulfillment_id",
    "occurred_at",
    "order_id",
    "reason"
  ],
  "title": "DeliveryException",
  "type": "object",
  "x-protean-aggregate": "fulfillment.fulfillment.fulfillment.Fulfillment",
  "x-protean-element-type": "event",
  "x-protean-fqn": "fulfillment.fulfillment.events.DeliveryException",
  "x-protean-published": true,
  "x-protean-type": "Fulfillment.DeliveryException.v1",
  "x-protean-version": 1
}
