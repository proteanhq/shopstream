{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A tracking event was received from the carrier.",
  "properties": {
    "description": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "fulfillment_id": {
      "minLength": 1,
      "type": "string"
    },
    "location": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "occurred_at": {
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "fulfillment_id",
    "occurred_at",
    "status"
  ],
  "title": "TrackingEventReceived",
  "type": "object",
  "x-protean-aggregate": "fulfillment.fulfillment.fulfillment.Fulfillment",
  "x-protean-element-type": "event",
  "x-protean-fqn": "fulfillment.fulfillment.events.TrackingEventReceived",
  "x-protean-type": "Fulfillment.TrackingEventReceived.v1",
  "x-protean-version": 1
}
