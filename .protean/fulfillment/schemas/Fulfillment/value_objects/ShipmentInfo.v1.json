{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Carrier shipment details.",
  "properties": {
    "actual_delivery": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "carrier": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "estimated_delivery": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "service_level": {
      "anyOf": [
        {
          "enum": [
            "Express",
            "Overnight",
            "Standard"
          ],
          "maxLength": 50,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "tracking_number": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "title": "ShipmentInfo",
  "type": "object",
  "x-protean-aggregate": "fulfillment.fulfillment.fulfillment.Fulfillment",
  "x-protean-element-type": "value_object",
  "x-protean-fqn": "fulfillment.fulfillment.fulfillment.ShipmentInfo"
}
