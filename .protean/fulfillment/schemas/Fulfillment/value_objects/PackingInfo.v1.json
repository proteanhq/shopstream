{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Packing completion details.",
  "properties": {
    "packed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "packed_by": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "shipping_label_url": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "title": "PackingInfo",
  "type": "object",
  "x-protean-aggregate": "fulfillment.fulfillment.fulfillment.Fulfillment",
  "x-protean-element-type": "value_object",
  "x-protean-fqn": "fulfillment.fulfillment.fulfillment.PackingInfo"
}
