{
  "doc": "The dispatcher claimed a pending notification for one send.\n\nCarries everything the send needs, so the dispatcher can send without\nloading the notification and opening a database transaction.",
  "fields": [
    {
      "name": "body",
      "type": "string"
    },
    {
      "name": "channel",
      "type": "string"
    },
    {
      "name": "notification_id",
      "type": {
        "logicalType": "uuid",
        "type": "string"
      }
    },
    {
      "name": "recipient_id",
      "type": {
        "logicalType": "uuid",
        "type": "string"
      }
    },
    {
      "name": "retry_count",
      "type": "long"
    },
    {
      "name": "started_at",
      "type": {
        "logicalType": "timestamp-millis",
        "type": "long"
      }
    },
    {
      "default": null,
      "name": "subject",
      "type": [
        "null",
        "string"
      ]
    }
  ],
  "name": "NotificationDispatchStarted",
  "namespace": "notifications.notification.events",
  "type": "record"
}
